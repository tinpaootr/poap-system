# Sao chép file này thành backend/.env rồi điền giá trị thật.
# KHÔNG commit file .env (đã có trong .gitignore).

PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>

# Pinata (đẩy ảnh + metadata huy hiệu lên IPFS)
PINATA_API_KEY=
PINATA_SECRET_KEY=

# ===== Mint hộ sinh viên (MỚI - bắt buộc) =====
# RPC Sepolia. Nên dùng Alchemy/Infura riêng; để trống sẽ dùng publicnode (dễ bị giới hạn).
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Private key VÍ MINTER = ví Admin cá nhân của chính bạn (Tuyền / Trâm / Kiệt - đã có quyền Admin
# trong constructor nên KHÔNG cần setAdmin). Ví này trả gas khi mint hộ sinh viên.
# CHỈ dùng ví testnet không chứa tài sản thật. Không gửi key cho ai, không commit.
# Ví khác ngoài 3 ví trên thì phải được owner (Kiệt) cấp quyền bằng scripts/setAdmin.js.
MINTER_PRIVATE_KEY=

# Địa chỉ contract ClubPOAP trên Sepolia (giống NEXT_PUBLIC_CONTRACT_ADDRESS ở frontend)
CONTRACT_ADDRESS=0x5D25Ebe07d284e27E63319F760543F2EBF859643

# (Tuỳ chọn) Block deploy contract - giúp đối soát txHash nhanh hơn
CONTRACT_DEPLOY_BLOCK=12158927

# (Tuỳ chọn) Thời gian tối đa chờ Sepolia xác nhận giao dịch mint (ms), mặc định 90000
MINT_WAIT_TIMEOUT_MS=90000
