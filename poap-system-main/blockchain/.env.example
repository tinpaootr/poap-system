# Sao chép file này thành blockchain/.env rồi điền giá trị thật.
# KHÔNG commit file .env (đã có trong .gitignore).

SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Private key ví OWNER (ví Kiệt) dùng để deploy contract và gọi setAdmin (cần ít ETH Sepolia).
# Có tiền tố 0x ở đầu (MetaMask xuất ra không có 0x thì tự thêm vào).
ADMIN_PRIVATE_KEY=

# Contract đang dùng trên Sepolia (block deploy 12158927)
CONTRACT_ADDRESS=0x5D25Ebe07d284e27E63319F760543F2EBF859643
# (Chỉ khi cần thêm Admin ngoài Tuyền/Trâm/Kiệt) địa chỉ ví - KHÔNG phải private key - cách nhau dấu phẩy,
# rồi owner chạy: npx hardhat run scripts/setAdmin.js --network sepolia
MINTER_ADDRESS=
