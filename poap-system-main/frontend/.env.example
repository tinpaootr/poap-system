# Sao chép file này thành frontend/.env.local rồi điền giá trị thật.

# Địa chỉ backend (có /api ở cuối)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Địa chỉ contract ClubPOAP trên Sepolia (giống CONTRACT_ADDRESS ở backend/.env)
NEXT_PUBLIC_CONTRACT_ADDRESS=0x5D25Ebe07d284e27E63319F760543F2EBF859643
